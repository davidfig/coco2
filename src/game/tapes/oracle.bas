10 REM THE ORACLE
20 CLS:X=RND(-TIMER)
30 PRINT "THE ORACLE KNOWS ALL."
40 PRINT "ASK IT A YES OR NO QUESTION,"
50 PRINT "OR PRESS ENTER TO LEAVE."
60 PRINT:LINE INPUT "? ";Q$
70 IF Q$="" THEN END
80 RESTORE:N=RND(8)
90 FOR I=1 TO N:READ A$:NEXT
100 PRINT "THE ORACLE SAYS:":PRINT A$
110 GOTO 60
120 DATA YES,NO,MAYBE,ASK AGAIN LATER
130 DATA "SIGNS POINT TO YES","DON'T COUNT ON IT"
140 DATA "WITHOUT A DOUBT","THE MISTS ARE CLOUDY"
