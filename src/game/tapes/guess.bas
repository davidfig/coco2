10 REM GUESS MY NUMBER
20 CLS:X=RND(-TIMER)
30 PRINT "GUESS MY NUMBER"
40 PRINT
50 PRINT "I AM THINKING OF A NUMBER"
60 PRINT "FROM 1 TO 100."
70 N=RND(100):T=0
80 PRINT:INPUT "YOUR GUESS";G
90 T=T+1
100 IF G<N THEN PRINT "TOO LOW.":GOTO 80
110 IF G>N THEN PRINT "TOO HIGH.":GOTO 80
120 PRINT:PRINT "YOU GOT IT IN";T;"TRIES!"
125 REM IS ANYONE READING THIS
130 PRINT:INPUT "PLAY AGAIN (Y/N)";A$
140 IF LEFT$(A$,1)="Y" THEN 20
150 END
