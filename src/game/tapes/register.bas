10 REM REGISTER
20 REM RAINBOW ON TAPE, JULY 1986
30 CLS
40 PRINT "REGISTER YOUR COMPUTER"
50 PRINT "ANSWER, THEN COPY THE CARD"
60 PRINT "ONTO THE FORM IN THE EDITORIAL."
70 PRINT
80 INPUT "YOUR NAME";N$
90 INPUT "SERIAL NUMBER";S$
100 INPUT "YOUR TOWN";T$
110 INPUT "COMPUTERS AT THIS ADDRESS";C
120 CLS
130 PRINT "REGISTRATION CARD"
140 PRINT STRING$(31,"-")
150 PRINT "OWNER:   ";N$
160 PRINT "SERIAL:  ";S$
170 PRINT "TOWN:    ";T$
180 PRINT "MACHINES:";C
190 PRINT "REMARKS: NONE"
200 PRINT STRING$(31,"-")
210 PRINT "SEND IT BY SEPTEMBER 1, 1986."
220 END
