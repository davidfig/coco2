10 REM CODER
20 REM RAINBOW ON TAPE, MAY 1986
30 REM TURNS WORDS INTO OUR CODE
40 CLS
50 PRINT "CODER: WORDS INTO NUMBERS"
60 PRINT "LETTERS AND SPACES ONLY."
70 PRINT
80 LINE INPUT "MESSAGE? ";M$
90 PRINT
100 PRINT "10 DATA ";
110 FOR I=1 TO LEN(M$)
120 C=ASC(MID$(M$,I,1))
130 IF C=32 THEN C=0 ELSE C=C-64
140 IF C<0 OR C>26 THEN 160
150 PRINT MID$(STR$(C),2);",";
160 NEXT
170 PRINT "-1"
180 PRINT
190 PRINT "TYPE THAT LINE IN, THEN RUN IT"
200 PRINT "WITH THE DECODER TO CHECK IT."
