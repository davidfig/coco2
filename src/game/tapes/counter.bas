10 REM COUNTER
20 REM RAINBOW ON TAPE, JULY 1986
30 REM A TAPE'S INDEX. PUT EACH
40 REM PROGRAM AND WHERE THE
50 REM COUNTER SAID IT STARTS IN
60 REM THE DATA FROM LINE 1000.
70 CLS
80 PRINT "TAPE INDEX"
90 PRINT STRING$(31,"-")
100 PRINT "PROGRAM";TAB(12);"COUNTER"
110 READ N$,C
120 IF N$="END" THEN 150
130 PRINT N$;TAB(12);C
140 GOTO 110
150 PRINT STRING$(31,"-")
160 PRINT "WRITE YOURS IN FROM LINE 1000."
170 END
1000 DATA ABOUT,0
1010 DATA REGISTER,18
1020 DATA COUNTER,52
1030 DATA GOODBYE,59
1990 DATA END,0
