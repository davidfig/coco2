10 REM CHECKUP
20 REM FROM THE HUMAN PLEDGE
30 CLS
40 PRINT "A CHECKUP FOR A SMALL SYSTEM"
50 PRINT "ANSWER YES OR NO."
60 PRINT
70 S=0
80 FOR Q=1 TO 3
90 READ Q$
100 PRINT Q$;
110 INPUT A$
120 IF LEFT$(A$,1)="Y" THEN S=S+1
130 NEXT
140 PRINT
150 IF S=0 THEN 200
160 PRINT "IT IS UNDERSTOOD THAT YOU ARE"
170 PRINT "WORRIED. SWITCH IT OFF NOW,"
180 PRINT "THEN CALL THE LINE:"
190 PRINT "606-555-0142.":END
200 PRINT "A HEALTHY SMALL SYSTEM."
210 PRINT "REST IT. WATCH IT."
220 PRINT "KEEP IT SMALL."
230 END
1000 DATA "IS IT SLOW TO ANSWER"
1010 DATA "ARE ITS COLOURS WRONG"
1020 DATA "SAYS WHAT YOU DID NOT TYPE"
