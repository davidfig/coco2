10 REM HANGMAN
20 CLS:X=RND(-TIMER)
30 RESTORE:FOR I=1 TO RND(12):READ W$:NEXT:G$="":M=0
40 CLS:PRINT "HANGMAN":PRINT:S$="":F=1
50 FOR I=1 TO LEN(W$):C$=MID$(W$,I,1)
60 IF INSTR(G$,C$) THEN S$=S$+C$ ELSE S$=S$+"-":F=0
70 NEXT:PRINT S$:PRINT
80 PRINT "MISSES";M;"OF 6: ";G$:PRINT
90 IF F THEN PRINT "YOU GOT IT!":GOTO 150
100 IF M=6 THEN PRINT "HANGED! IT WAS ";W$:GOTO 150
110 INPUT "LETTER";L$:L$=LEFT$(L$,1)
120 IF L$="" OR INSTR(G$,L$) THEN 40
130 G$=G$+L$:IF INSTR(W$,L$)=0 THEN M=M+1
140 GOTO 40
150 PRINT:INPUT "AGAIN (Y/N)";A$
160 IF LEFT$(A$,1)="Y" THEN 30
170 END
